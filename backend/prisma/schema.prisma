generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  artifacts    Artifact[]
}

model Artifact {
  id        Int          @id @default(autoincrement())
  type      ArtifactType
  content   Json
  x         Float        @default(0)
  y         Float        @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  userId    Int
  zIndex    Int          @default(0)
  user      User         @relation(fields: [userId], references: [id])
}

enum ArtifactType {
  TEXT
}
